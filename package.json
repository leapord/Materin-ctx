{
	"name": "materin-ctx",
	"version": "0.1.1",
	"description": "Obsidian plugin that opens JSON / YAML files in a native-feeling CodeMirror view with formatting, folding and search.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"check": "tsc -noEmit -skipLibCheck",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"json",
		"yaml",
		"code-editor"
	],
	"author": "qiyuyang",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/commands": "^6.7.0",
		"@codemirror/language": "^6.10.0",
		"@codemirror/search": "^6.5.0",
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@lezer/highlight": "^1.2.0",
		"@types/node": "^22.10.0",
		"esbuild": "^0.25.0",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "latest",
		"tslib": "^2.8.1",
		"typescript": "^5.8.0",
		"typescript-eslint": "^8.68.0",
		"vitest": "^3.0.0"
	},
	"dependencies": {
		"@codemirror/lang-json": "^6.0.1",
		"@codemirror/lang-yaml": "^6.1.2",
		"jsonc-parser": "^3.3.1",
		"yaml": "^2.9.0"
	}
}
